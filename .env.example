# Skopiuj ten plik jako .env:  cp .env.example .env
# Wartości poniżej są TYLKO do lokalnego uruchomienia - na produkcji ustaw własne.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=roombooking
DB_PORT=5432
API_PORT=3000

# --- aplikacja uruchamiana lokalnie (npm start) ---
PORT=3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/roombooking
# min. 32 znaki; własny: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me-0123456789abcdefghijklmnop
JWT_EXPIRES_IN=15m
BCRYPT_ROUNDS=12

# --- testy integracyjne (npm test) - osobna baza, nazwa MUSI kończyć się na _test ---
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/roombooking_test
