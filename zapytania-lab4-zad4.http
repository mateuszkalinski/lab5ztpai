### ---------- PATCH /api/reservations/6/cancel: brak tokenu / obcy / właściciel / ADMIN
# kolejność: obcy przed właścicielem (po anulowaniu przez właściciela ADMIN dostaje 200 bez zmian)
PATCH {{baseUrl}}/reservations/6/cancel

###
PATCH {{baseUrl}}/reservations/6/cancel
Authorization: Bearer {{other.response.body.accessToken}}

###
PATCH {{baseUrl}}/reservations/6/cancel
Authorization: Bearer {{owner.response.body.accessToken}}

###
PATCH {{baseUrl}}/reservations/6/cancel
Authorization: Bearer {{admin.response.body.accessToken}}

### ---------- reguły biznesowe obowiązują także ADMINa: anulowanie rozpoczętej rezerwacji 1 -> 409
PATCH {{baseUrl}}/reservations/1/cancel
Authorization: Bearer {{admin.response.body.accessToken}}
